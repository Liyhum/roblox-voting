# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (include production build, exclude cache & standalone)
/.next/cache/
/.next/dev/
/.next/diagnostics/
/.next/standalone/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
# runtime local state
.event-status.json
.device-voters.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

graphify-out/
